{
  "name": "storytelling-studio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:core": "node --test tests/core/*.test.mjs tests/project-schema/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs start",
    "dev:status": "node scripts/dev.mjs status",
    "dev:stop": "node scripts/dev.mjs stop",
    "lint": "eslint scripts apps/studio/src apps/local-service/src packages --ext .mjs,.ts",
    "typecheck": "tsc --noEmit",
    "test:docs": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:docs && npm run test:core",
    "test:core": "node --test tests/core/*.test.mjs tests/project-schema/*.test.mjs"
  }
}
