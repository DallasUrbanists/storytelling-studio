{
  "name": "storytelling-studio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs start",
    "dev:status": "node scripts/dev.mjs status",
    "dev:stop": "node scripts/dev.mjs stop",
    "lint": "eslint scripts apps/studio/src apps/local-service/src packages --ext .mjs,.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/renderer/tsconfig.json && node scripts/check-studio.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:docs && npm run test:core && npm run test:research && npm run test:roadway && npm run test:persistence && npm run test:integrated",
    "test:core": "node --test tests/core/*.test.mjs tests/project-schema/*.test.mjs tests/roadway/*.test.mjs",
    "test:research": "node --test tests/research/*.test.mjs",
    "test:roadway": "node --test --test-isolation=none tests/roadway/*.test.mjs tests/roadway/*.test.ts",
    "render:fixture": "node scripts/render-fixture.mjs",
    "test:render-contract": "node --env-file-if-exists=.env tests/render-contract/run.mjs",
    "test:render-contract:unit": "node --test --test-isolation=none tests/render-contract/compare.test.mjs tests/render-contract/browser.test.mjs",
    "build:studio": "npm run build --workspace @gstory/studio",
    "test:persistence": "node --test --test-isolation=none tests/persistence/*.test.*",
    "test:integrated": "node --test --test-isolation=none tests/integrated/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@remotion/bundler": "4.0.542",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "@vue/compiler-sfc": "3.5.45"
  }
}
