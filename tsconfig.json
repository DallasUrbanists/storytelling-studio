{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.mjs",
    "apps/*/src/**/*.mjs",
    "packages/**/*.ts"
  ]
}
